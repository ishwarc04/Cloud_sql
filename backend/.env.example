# Set these values in the backend process environment or Render dashboard.
# Spring Boot does not automatically load this example file.
DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST/YOUR-DATABASE?sslmode=require
DATABASE_USERNAME=YOUR_NEON_USERNAME
DATABASE_PASSWORD=YOUR_NEON_PASSWORD
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_SESSION_HOURS=24
# Optional trusted backend provisioning. Never put these in frontend variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
