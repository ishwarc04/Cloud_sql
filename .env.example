# Frontend (copy to .env.local)
VITE_API_BASE_URL=http://localhost:8080

# Vercel server environment: use the proxy and leave VITE_API_BASE_URL empty.
BACKEND_API_URL=https://YOUR-BACKEND.onrender.com

# Backend / Neon (set in your terminal or hosting dashboard)
DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST/YOUR-DATABASE?sslmode=require
DATABASE_USERNAME=YOUR_NEON_USERNAME
DATABASE_PASSWORD=YOUR_NEON_PASSWORD
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_SESSION_HOURS=24
# Optional trusted backend provisioning, never VITE_ variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
